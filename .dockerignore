# Keep the image small and free of local/test artefacts.
.git
.gitignore
.DS_Store
__pycache__/
*.pyc
.venv/
venv/

# Local data, examples and generated output — never bake these into the image.
input/
output/
examples_original/
*.docx
*.xlsx

# Docs and planning — not needed at runtime.
README.md
SCOPE.md
deploy/

# CLI is not used by the container (but harmless if present).
fill_docs.py
